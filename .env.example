# ==============================================================================
# CampusBites Environment Configuration Template
# Copy this file to .env and replace placeholders with production secrets
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-me-to-a-secure-random-64-char-hex-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite in local dev)
# Example PostgreSQL: postgresql://canteen_user:secret_password@db:5432/canteen_db
DATABASE_URL=sqlite:///./canteen.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS & Allowed Origins (Comma-separated list of origins)
FRONTEND_URL=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Payment Gateway Configuration
# Mode: SANDBOX or PRODUCTION
PAYMENT_MODE=SANDBOX
PAYMENT_WEBHOOK_SECRET=change-me-to-a-secure-webhook-secret-token

# Razorpay credentials (Required if PAYMENT_MODE=PRODUCTION)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# UPI Gateway / Custom Gateway credentials
UPI_MERCHANT_VPA=canteen@upi
UPI_MERCHANT_NAME=CampusBites Food Court

# Email / SMTP Configuration (Optional, logs to console if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@campusbites.internal

# Rate Limiting
PICKUP_VERIFICATION_MAX_ATTEMPTS=5
PICKUP_VERIFICATION_LOCKOUT_MINUTES=15
